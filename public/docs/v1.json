  "components": {
    "schemas": {
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DEGRADED",
              "DOWN",
              "MAINTENANCE",
              "UNVERIFIABLE"
            ]
          },
          "uptime": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "tenantCount": {
            "type": "integer"
          },
          "activeAlerts": {
            "type": "integer"
          },
          "firingIncidents": {
            "type": "integer"
          }
        }
      },
      "Monitor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/TargetConfig"
          },
          "schedule": {
            "$ref": "#/components/schemas/ScheduleConfig"
          },
          "assertion": {
            "$ref": "#/components/schemas/AssertionConfig"
          },
          "missingDataPolicy": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PAUSED",
              "DELETED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateMonitorRequest": {
        "type": "object",
        "required": [
          "name",
          "target",
          "schedule"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/TargetConfig"
          },
          "schedule": {
            "$ref": "#/components/schemas/ScheduleConfig"
          },
          "assertion": {
            "$ref": "#/components/schemas/AssertionConfig"
          },
          "missingDataPolicy": {
            "type": "string"
          }
        }
      },
      "TargetConfig": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "http",
              "tcp"
            ]
          },
          "http": {
            "$ref": "#/components/schemas/HTTPConfig"
          },
          "tcp": {
            "$ref": "#/components/schemas/TCPConfig"
          }
        }
      },
      "HTTPConfig": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "default": "GET"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "type": "string"
          },
          "expectedStatus": {
            "type": "integer",
            "default": 200
          },
          "tlsSkipVerify": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "TCPConfig": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "tlsEnabled": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ScheduleConfig": {
        "type": "object",
        "required": [
          "intervalSeconds",
          "timeoutSeconds"
        ],
        "properties": {
          "intervalSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AssertionConfig": {
        "type": "object",
        "properties": {
          "type": {
